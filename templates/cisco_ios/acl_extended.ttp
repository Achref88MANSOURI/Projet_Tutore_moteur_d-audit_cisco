<vars>
acl_action = "permit|deny"
acl_address = 'any(?:4|6)?|host\\s+\\S+|object-group\\s+\\S+|\\d+\\.\\d+\\.\\d+\\.\\d+(?:\\s+\\d+\\.\\d+\\.\\d+\\.\\d+)?|[0-9A-Fa-f:]+/\\d+'
acl_port = '(?:eq|neq|lt|gt)\\s+\\S+|range\\s+\\S+\\s+\\S+'
</vars>

<group name="acl_extended_0_0_0_0_0*" method="table">
{{ source_line | DIGIT | to_int }} {{ action | re("acl_action") }} {{ protocol }} {{ source | re("acl_address") }} {{ destination | re("acl_address") }}
</group>

<group name="acl_extended_0_0_0_0_1*" method="table">
{{ source_line | DIGIT | to_int }} {{ action | re("acl_action") }} {{ protocol }} {{ source | re("acl_address") }} {{ destination | re("acl_address") }} {{ options | ORPHRASE }}
</group>

