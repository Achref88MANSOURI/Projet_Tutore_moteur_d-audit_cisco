<!-- Literal v2c forms are kept separate from the legacy greedy tables.  TTP
     otherwise drops the redacted community operand when several host
     syntaxes coexist in the same template. -->
<group name="services_snmp_host_traps_v2c*" method="table">
{{ source_line | DIGIT | to_int }} snmp-server host {{ destination }} traps version 2c {{ community_user }}
</group>

<group name="services_snmp_host_informs_v2c*" method="table">
{{ source_line | DIGIT | to_int }} snmp-server host {{ destination }} informs version 2c {{ community_user }}
</group>

