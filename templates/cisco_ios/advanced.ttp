<group name="advanced_isis*" method="table">
{{ source_line | DIGIT | to_int }} router isis {{ process }}
</group>

<group name="advanced_isis_net*" method="table">
{{ source_line | DIGIT | to_int }} net {{ net }}
</group>

<group name="advanced_isis_passive*" method="table">
{{ source_line | DIGIT | to_int }} passive-interface {{ interface }}
</group>

<group name="advanced_mpls_ldp*" method="table">
{{ source_line | DIGIT | to_int }} mpls ldp router-id {{ interface }} {{ option }}
</group>

<group name="advanced_mpls_label*" method="table">
{{ source_line | DIGIT | to_int }} mpls label protocol {{ protocol }}
</group>

<group name="advanced_qos_classmap*" method="table">
