# Keep only the two current public Level 2 documents by default. Other files
# in this tree are research inputs, validation evidence or historical reports.
/docs/cis_level2_validation/*
!/docs/cis_level2_validation/DOCUMENTATION_ARCHITECTURE_MOTEUR_AUDIT_CIS.md
!/docs/cis_level2_validation/AUDIT_CIS_PROFIL_CUMULATIF_OBLIGATOIRE.md

# Historical integration/dashboard reports retained locally.
/docs/cis_catalog_integration/PHASE5*.md
/docs/dashboard/ARCHITECTURE.md
/docs/dashboard/PHASE6_VALIDATION.md
/docs/audit_phase1_oracle.md
/docs/audit_phase2_normalization_review.md

# Keep the small maintained toolset already tracked plus the schema builder.
# Phase-specific reporting and campaign scripts remain local development aids.
/tools/*
