.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Local archive of tests, reports, corpora and development-only artefacts.
# This directory is intentionally excluded from publication and runtime use.
/à exclu/

# Generated caches, reports and local validation outputs
/cache/
/dist/
/outputs/
/baseline/
/tmp/
/hors/

# Local or third-party Cisco corpora. They may contain credentials,
# internal addressing or material whose publication rights are unverified.
/configs/

# Dependency source checkouts are development-only. Reproducible runtime
# dependencies are supplied by requirements.lock and wheelhouse/.
/vendor/

# Local secrets and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore

# Editors, operating systems and transient logs
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
*~

